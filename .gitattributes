# 统一行尾，避免不同系统 clone 后 diff 全变
* text=auto

# Windows 脚本必须是 CRLF，否则 cmd/powershell 可能报错
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# 源码与脚本统一 LF
*.py   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.puml text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

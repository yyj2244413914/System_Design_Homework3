@startuml
' 组件图比类图更适合表达"前后端架构"：它天生就是画进程/模块边界 + 接口的
skinparam componentStyle rectangle
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false

package "客户端（浏览器）" {
  [login.html] as login
  [index.html] as index
  [room.html] as room
  [api.js\n(fetch 封装 + Token)] as api
  [style.css] as css
}

package "服务器（python.exe :8000）" {
  [FastAPI 路由\napp.py] as routes
  [会话管理\nSESSIONS] as session
  [数据访问\ndb.py] as dao
  [配置\nconfig.py] as cfg
}

database "OceanBase :2881\nIntelligent_Classroom（10 张表）" as db

login --> api
index --> api
room  --> api
api ..> routes : «HTTP» JSON\nPOST /api/login …
routes --> session
routes --> dao : SQL
dao --> cfg
dao ..> db : «TCP» PyMySQL 3306/2881

note right of api
  浏览器不能直连数据库：
  没有 MySQL 协议，且账号会暴露
end note

note bottom of db
  user / role / user_role / menu / role_menu
  course / class_member / chat_room
  chat_record / chat_room_record
end note

@enduml
